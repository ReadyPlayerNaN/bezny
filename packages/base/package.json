  "devDependencies": {
    "@bezny/typescript-config": "workspace:*",
    "@playwright/test": "1.63.0",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^24.0.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "jsdom": "30.1.2",
    "magic-string": "0.30.21",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sass": "1.105.1",
