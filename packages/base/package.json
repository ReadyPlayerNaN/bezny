{
  "name": "@bezny/base",
  "version": "0.0.0",
  "private": true,
  "files": [
    "dist",
    "src/tokens/_viewports.scss",
    "src/tokens/_logical.scss",
    "src/tokens/_foundational.scss",
    "src/tokens/_css-properties.scss"
  ],
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./style.css": "./dist/style.css",
    "./viewports": {
      "sass": "./src/tokens/_viewports.scss"
    }
  },
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run && node --test test/*.test.mjs",
    "test:scroll-lock:browser": "node --test test/scroll-lock.browser.mjs"
  },
  "dependencies": {
    "@radix-ui/react-alert-dialog": "1.1.24",
