{
  "name": "@bezny/admin",
  "version": "0.0.0",
  "private": true,
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/admin-provider.d.ts",
      "import": "./dist/admin-provider.js"
    },
    "./layout": {
      "types": "./dist/admin-layout.d.ts",
      "import": "./dist/admin-layout.js"
    },
    "./page": {
      "types": "./dist/admin-page.d.ts",
      "import": "./dist/admin-page.js"
    },
    "./building-blocks": {
      "types": "./dist/admin-building-blocks.d.ts",
      "import": "./dist/admin-building-blocks.js"
    },
    "./entities": {
      "types": "./dist/admin-entity-model.d.ts",
      "import": "./dist/admin-entity-model.js"
    },
    "./application": {
      "types": "./dist/admin-entity-routing.d.ts",
      "import": "./dist/admin-entity-routing.js"
    },
    "./runtime": {
      "types": "./dist/admin-application-runtime.d.ts",
      "import": "./dist/admin-application-runtime.js"
    },
    "./routes": {
      "types": "./dist/admin-route-bindings.d.ts",
      "import": "./dist/admin-route-bindings.js"
    },
    "./context": {
      "types": "./dist/admin-entity-context.d.ts",
      "import": "./dist/admin-entity-context.js"
    },
    "./commands": {
      "types": "./dist/admin-entity-commands.d.ts",
      "import": "./dist/admin-entity-commands.js"
    },
    "./adapters": {
      "types": "./dist/admin-data-adapter.d.ts",
      "import": "./dist/admin-data-adapter.js"
    },
    "./i18n": {
      "types": "./dist/admin-i18n.d.ts",
      "default": "./dist/admin-i18n.js"
    },
    "./list": {
      "types": "./dist/admin-list-controls.d.ts",
      "default": "./dist/admin-list-controls.js"
    },
    "./data": {
      "types": "./dist/admin-data-session.d.ts",
      "import": "./dist/admin-data-session.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsr generate && tsc --noEmit",
    "test": "tsr generate && vitest run && node test/build-smoke.mjs"
  },
  "dependencies": {
    "@bezny/base": "workspace:*",
    "@radix-ui/react-direction": "^1.1.5",
    "@tanstack/react-router": "1.170.41",
    "i18next": "^26.4.2",
    "jotai": "3.0.1",
    "react-i18next": "^17.0.16"
  },
  "devDependencies": {
    "@bezny/typescript-config": "workspace:*",
    "@tanstack/router-cli": "1.167.38",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^24.0.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "jsdom": "30.1.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "typescript": "7.0.2",
    "vitest": "5.0.3"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  }
}
